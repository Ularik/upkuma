# Скопируйте в .env и заполните.

# Токен Telegram-бота (@BotFather)
TELEGRAM_TOKEN=

# Разрешённые chat ID через запятую (группа «Мониторинг сайтов»)
ALLOWED_CHAT_IDS=

# Адрес Uptime Kuma (по умолчанию http://localhost:3001)
KUMA_URL=http://localhost:3001

# API-ключ Uptime Kuma (Настройки → API Keys)
KUMA_API_KEY=
